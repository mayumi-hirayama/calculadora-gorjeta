function calcularGorjeta() {
    const conta = parseFloat(document.getElementById('conta').value);
    const porcentagem = parseFloat(document.getElementById('gorjeta').value);

    if (isNaN(conta) || isNaN(porcentagem)) {
        document.getElementById('resultado').innerText = 'Preencha os campos!';
        return;
    }

    const gorjeta = conta * (porcentagem / 100);
    const total = conta + gorjeta;

    document.getElementById('resultado').innerText = `Gorjeta: R$ ${gorjeta.toFixed(2)} | Total: R$ ${total.toFixed(2)}`;
}